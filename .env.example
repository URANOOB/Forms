DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Bogota
# Origen canónico para enlaces compartidos; vacío usa el dominio de la petición.
PUBLIC_BASE_URL=
DATABASE_URL=postgresql://forms:forms_local_only@127.0.0.1:55432/forms
# Supabase: usar conexión directa o session pooler y sslmode=require.
# Nunca utilizar credenciales de producción para ejecutar tests.
# Mantener local hasta terminar y verificar la copia de los archivos existentes.
FILE_STORAGE=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Capacidad de la base conectada, en bytes. Supabase Free: 500000000.
DATABASE_CAPACITY_BYTES=
# Referencia instantánea, NO capacidad máxima ni saldo mensual. R2 Standard: 10000000000.
R2_FREE_STORAGE_REFERENCE_BYTES=
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
