DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=America/Bogota
# Origen canónico para enlaces compartidos; vacío usa el dominio de la petición.
PUBLIC_BASE_URL=
DATABASE_URL=postgresql://forms:forms_local_only@127.0.0.1:55432/forms
# Supabase: usar conexión directa o session pooler y sslmode=require.
# Nunca utilizar credenciales de producción para ejecutar tests.
# Local solo para desarrollo. Producción exige r2 y credenciales completas.
FILE_STORAGE=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Solicitudes por IP: lectura pública/minuto, envío/minuto y envío/hora.
RATE_LIMIT_PUBLIC_READ=120
RATE_LIMIT_PUBLIC_POST=10
RATE_LIMIT_PUBLIC_HOUR=60
# Intentos de login por IP/5 minutos y por cuenta/15 minutos.
RATE_LIMIT_LOGIN_IP=20
RATE_LIMIT_LOGIN_ACCOUNT=10
# Capacidad de la base conectada, en bytes. Supabase Free: 500000000.
DATABASE_CAPACITY_BYTES=
# Referencia instantánea, NO capacidad máxima ni saldo mensual. R2 Standard: 10000000000.
R2_FREE_STORAGE_REFERENCE_BYTES=
EMAIL_PROVIDER=resend
EMAIL_FROM=LogicForms <notificaciones@logicforms.xyz>
EMAIL_API_KEY=
RESEND_WEBHOOK_SECRET=
# Desactivado por defecto: activar después de configurar proveedor y URL pública.
EMAIL_NOTIFICATIONS_ENABLED=False
# En pruebas redirige todos los avisos a esta dirección; dejar vacío en producción.
EMAIL_TEST_RECIPIENT=
